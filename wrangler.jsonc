{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skarbonka",
  "main": "src/worker/index.ts",
  // One entrance: the family subdomain. (Access lock arrives with issue 02.)
  "workers_dev": false,
  "routes": [{ "pattern": "skarbonka.sdfg.pl", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Cloudflare Vite plugin injects the build output directory at deploy time.
    // SPA: unknown paths serve index.html; API paths always reach the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Filled in by the Zero Trust dashboard step (issue 02). Until then these
  // are empty and every API request is rejected — fail closed.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skarbonka",
      "database_id": "213e9eca-0ab0-4edd-9000-cd4b29d04abd",
      "migrations_dir": "migrations"
    }
  ]
}
