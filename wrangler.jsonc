{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skarbonka",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Cloudflare Vite plugin injects the build output directory at deploy time.
    // SPA: unknown paths serve index.html; API paths always reach the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skarbonka",
      // Placeholder until `wrangler d1 create skarbonka` (see issue 01, human step).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
