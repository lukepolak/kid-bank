{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skarbonka",
  "main": "src/worker/index.ts",
  // One entrance: the family subdomain. (Access lock arrives with issue 02.)
  "workers_dev": false,
  "routes": [{ "pattern": "skarbonka.sdfg.pl", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Cloudflare Vite plugin injects the build output directory at deploy time.
    // SPA: unknown paths serve index.html; API paths always reach the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Zero Trust anchors for the Access application protecting this Worker (issue 02).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://dev-polak.cloudflareaccess.com",
    "ACCESS_AUD": "1eec8a64490b16abd5ed302e85590d232a130f0840b417de2f6edc8a98a6cda8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skarbonka",
      "database_id": "213e9eca-0ab0-4edd-9000-cd4b29d04abd",
      "migrations_dir": "migrations"
    }
  ]
}
